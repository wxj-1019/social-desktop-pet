{
  "name": "ai-social-desktop-pet",
  "version": "0.0.0",
  "private": true,
  "description": "跨平台 AI 社交桌宠：面向真实好友共同养成的桌宠（Electron + Supabase + Graph Engineering）",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @pet/desktop dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @pet/desktop build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @pet/desktop build && playwright test --config e2e/playwright.config.ts",
    "bench:resources": "node tools/bench/resource-bench.mjs",
    "clean": "pnpm -r exec rimraf dist node_modules/.cache .turbo || true",
    "prepare": "husky",
    "deno:check": "deno check --config packages/supabase/deno.json packages/supabase/functions/chat/index.ts || echo 'deno 未安装，跳过（CI 会检查）'",
    "deno:lint": "deno lint --config packages/supabase/deno.json packages/supabase/functions/ || echo 'deno 未安装，跳过（CI 会检查）'"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,json}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{md,yaml,yml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@pet/eslint-config": "workspace:*",
    "@pet/tsconfig": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
