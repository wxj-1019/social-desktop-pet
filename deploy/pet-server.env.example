# 生产环境模板（D-13 自建后端）—— 复制为 /etc/pet/pet-server.env（chmod 600）
# 生成强随机密钥：openssl rand -base64 48

# Postgres（生产：独立用户，勿用 postgres 超级用户）
DATABASE_URL=postgres://pet:CHANGE_ME@127.0.0.1:5432/pet

# JWT 签名密钥（必须替换；泄露 = 可伪造 access token）
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# 服务端口（Nginx/Caddy 反向代理到此）
PORT=8787

# 模型供应商密钥（8.3：只存服务端；GLM-4-Flash 免费档示例）
# AI_MODEL_API_KEY=CHANGE_ME
# AI_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL_NAME=glm-4-flash

# 更新源（manifest.json 静态文件，13.1）
# UPDATE_MANIFEST_URL=https://updates.example.com/pet/manifest.json
