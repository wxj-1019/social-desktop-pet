# 复制为 .env.local（本地开发）或服务端环境变量（生产）
# 自建后端（D-13）：模型供应商密钥绝不进客户端（8.3），只存服务端

# Postgres 连接（本地 Docker：docker run -d --name pet-pg -e POSTGRES_PASSWORD=pet -p 5432:5432 postgres:16）
DATABASE_URL=postgres://postgres:pet@localhost:5432/pet

# 自建 Auth（jose JWT；生产用强随机值，如 openssl rand -base64 48）
JWT_SECRET=dev-only-change-me
# access token TTL（9.8：缩短以缩小撤销滞后窗口）
ACCESS_TOKEN_TTL_MIN=15
# refresh token TTL（滑动窗口轮换：每次 /auth/refresh 按当前值续期；
# 设长（如 3650）即"长期保持登录"，只要 TTL 内启动过一次应用就不掉线。
# 默认 30 天；本地桌宠常驻可调大。clamp 上限 3650 天）
REFRESH_TOKEN_TTL_DAYS=30

# 服务端口
PORT=8787

# 监听地址（部署边界）：默认只绑回环 127.0.0.1，杜绝误配直暴公网；
# 容器/反代异机需对外时显式设 0.0.0.0（启动会高声警告，务必配防火墙/反代限制来源）
# PET_BIND_HOST=127.0.0.1

# 可信反向代理（限流取 X-Forwarded-For 首段；仅在反代"覆盖而非透传"该头时开启，
# 否则一律用 TCP 对端地址——直接信任客户端可伪造的 XFF 会绕过 IP 限流并伪造审计 IP）
# PET_TRUST_PROXY=true

# 管理后台（/admin）：生产（NODE_ENV=production）必须设 true（HTTPS 部署强制 Secure cookie，
# 缺失时服务拒绝启动）；本地 HTTP 开发保持注释
# ADMIN_COOKIE_SECURE=true

# 模型供应商密钥（AI Gateway 服务端专用；8.3：绝不进客户端）
# 未配置时 chat 降级为骨架回复。OpenAI 兼容协议（GLM-4-Flash 免费档示例）：
# AI_MODEL_API_KEY=your-key
# AI_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL_NAME=glm-4-flash
# DeepSeek：AI_MODEL_BASE_URL=https://api.deepseek.com AI_MODEL_NAME=deepseek-chat

# 嵌入模型（10.7 向量检索臂；未配置时记忆检索降级 FTS-only，RRF 单臂语义不变）
# 缺省复用 AI_MODEL_API_KEY / AI_MODEL_BASE_URL（同供应商时只需配模型名）：
# EMBEDDING_MODEL=text-embedding-3-small
# 或独立供应商：
# EMBEDDING_API_KEY=your-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# 历史记忆回填：pnpm --filter @pet/server backfill-embeddings（幂等，可重跑）

# 邮件（13.2 事务邮件：waitlist 报名确认 + 邮箱 OTP 登录；未配置时降级为日志发送，不阻塞业务）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=robot
# SMTP_PASS=secret
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=false   # 生产 465 端口需 true（隐式 TLS）
# 仅本地开发/e2e：OTP 验证码随 /auth/otp/request 响应返回（生产绝不开启）
# PET_DEV_OTP_CODE_IN_RESPONSE=true

# Waitlist 运营邀请端点（4.3 状态机：POST /waitlist/invite 发放邀请，
# 响应含明文兑换码——仅限本地/e2e 批量补发；生产一律 404，
# 运营邀请统一走管理后台 /admin/waitlist/:id/invite；未配置则端点 404 不暴露）
# WAITLIST_ADMIN_TOKEN=op-secret
# 邀请邮件中的兑换链接前缀（landing 兑换页；缺省只发兑换码）
# WAITLIST_CLAIM_URL_BASE=https://your-domain/claim
