# 复制为 .env.local（本地开发）或服务端环境变量（生产）
# 自建后端（D-13）：模型供应商密钥绝不进客户端（8.3），只存服务端

# Postgres 连接（本地 Docker：docker run -d --name pet-pg -e POSTGRES_PASSWORD=pet -p 5432:5432 postgres:16）
DATABASE_URL=postgres://postgres:pet@localhost:5432/pet

# 自建 Auth（jose JWT；生产用强随机值，如 openssl rand -base64 48）
JWT_SECRET=dev-only-change-me
# access token TTL（9.8：缩短以缩小撤销滞后窗口）
ACCESS_TOKEN_TTL_MIN=15
# refresh token TTL
REFRESH_TOKEN_TTL_DAYS=30

# 服务端口
PORT=8787

# 模型供应商密钥（AI Gateway 服务端专用；8.3：绝不进客户端）
# 未配置时 chat 降级为骨架回复。OpenAI 兼容协议（GLM-4-Flash 免费档示例）：
# AI_MODEL_API_KEY=your-key
# AI_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL_NAME=glm-4-flash
# DeepSeek：AI_MODEL_BASE_URL=https://api.deepseek.com AI_MODEL_NAME=deepseek-chat
