{
  "name": "@pet/server",
  "version": "0.0.0",
  "private": true,
  "description": "自建后端（D-13）：Postgres + Node（HTTP + WebSocket + 自建 Auth）",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -b",
    "migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "backfill-embeddings": "tsx --env-file=.env.local scripts/backfill-embeddings.ts",
    "admin:create": "tsx --env-file=.env.local scripts/admin-create.ts",
    "test": "cd ../.. && vitest run apps/server"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@node-rs/argon2": "^2.0.2",
    "@pet/ai-graph": "workspace:*",
    "@pet/config": "workspace:*",
    "@pet/protocol": "workspace:*",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "vitest": "^2.1.9"
  }
}
