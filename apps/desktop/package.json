{
  "name": "@pet/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron 桌面端（透明置顶窗 + Live2D + React）",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web"
  },
  "dependencies": {
    "@pet/config": "workspace:*",
    "@pet/pet-state": "workspace:*",
    "@pet/protocol": "workspace:*",
    "@pet/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.8"
  }
}
